{
  "expectation_suite_name": "media_spend",
  "meta": {
    "//": "Sample Great Expectations suite. The data team replaces the columns and ranges with the agreed contract; data.yml publishes data/quality/*.json to s3://<data-quality>/suites/.",
    "owner": "mmm-data",
    "applies_to": "landing/<business_unit>/media_spend/*"
  },
  "expectations": [
    { "expectation_type": "expect_table_row_count_to_be_between", "kwargs": { "min_value": 1 } },
    { "expectation_type": "expect_table_columns_to_match_set", "kwargs": { "column_set": ["week_start", "business_unit", "title_id", "channel", "spend_usd", "impressions"], "exact_match": false } },
    { "expectation_type": "expect_column_values_to_not_be_null", "kwargs": { "column": "week_start" } },
    { "expectation_type": "expect_column_values_to_not_be_null", "kwargs": { "column": "title_id" } },
    { "expectation_type": "expect_column_values_to_be_in_set", "kwargs": { "column": "business_unit", "value_set": ["usnetworks", "streaming", "theatrical"] } },
    { "expectation_type": "expect_column_values_to_be_between", "kwargs": { "column": "spend_usd", "min_value": 0 } },
    { "expectation_type": "expect_column_values_to_be_between", "kwargs": { "column": "impressions", "min_value": 0 } },
    { "expectation_type": "expect_compound_columns_to_be_unique", "kwargs": { "column_list": ["week_start", "title_id", "channel"] } }
  ]
}
